{
  "manifest_version": 3,
  "name": "Hotel Norte — Conector Automático Booking.com (ID 2862226)",
  "version": "2.0.0",
  "description": "Sincronización 100% autónoma en segundo plano desde Booking.com Extranet (Hotel Norte #2862226) hacia el PMS al recargar la página, sin abrir Booking ni elegir fechas.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://admin.booking.com/*",
    "http://localhost:3847/*",
    "http://127.0.0.1:3847/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://admin.booking.com/*"
      ],
      "js": [
        "content_booking.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3847/*",
        "http://127.0.0.1:3847/*",
        "file:///*"
      ],
      "js": [
        "content_pms.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
